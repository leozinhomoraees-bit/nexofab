# Supabase > Project Settings > API Keys
# Use exclusivamente as credenciais do novo projeto Supabase do NexoFab.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-NOVO-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-nova-chave-publica

# Cobrança Asaas (SOMENTE servidor — nunca use prefixo NEXT_PUBLIC_)
# Use "sandbox" para testes em sandbox.asaas.com e "production" somente após validar.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=sua-chave-api-asaas-sandbox
ASAAS_WEBHOOK_TOKEN=um-segredo-aleatorio-forte-para-validar-webhooks
